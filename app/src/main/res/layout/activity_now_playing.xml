<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top bar: back arrow + "Now Playing" title + menu dots -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="44dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Back button — replace drawable with your own ic_back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Now Playing"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Placeholder for a menu / options icon (add your drawable later) -->
        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Menu"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- Album Art Carousel Area (center album + peeking side albums) -->
    <!-- ============================================================ -->
    <FrameLayout
        android:id="@+id/albumArtContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Left peeking album art (partially visible) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlbumLeft"
            android:layout_width="80dp"
            android:layout_height="280dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="-30dp"
            android:alpha="0.5"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A1A1A">

            <ImageView
                android:id="@+id/imgAlbumLeft"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Previous album art" />
        </androidx.cardview.widget.CardView>

        <!-- Center album art (main) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlbumCenter"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#2A2A2A">

            <ImageView
                android:id="@+id/imgAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Album art" />
        </androidx.cardview.widget.CardView>

        <!-- Right peeking album art (partially visible) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlbumRight"
            android:layout_width="80dp"
            android:layout_height="280dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-30dp"
            android:alpha="0.5"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A1A1A">

            <ImageView
                android:id="@+id/imgAlbumRight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Next album art" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- ============================================================ -->
    <!-- Song Info: Title + Artist -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/songInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/albumArtContainer"
        android:layout_marginTop="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bank Account"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArtistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="21 Savage"
            android:textColor="#AAAAAA"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- Heart / Favourite icon placeholder (add drawable later) -->
    <!-- ============================================================ -->
    <ImageView
        android:id="@+id/btnFavourite"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_below="@id/songInfoContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:contentDescription="Favourite"
        android:visibility="invisible" />

    <!-- ============================================================ -->
    <!-- Bottom controls anchored to bottom of screen -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- ====================================================== -->
        <!-- Curved SeekBar                                          -->
        <!-- The "curve" effect is done via rotation on the SeekBar  -->
        <!-- wrapped in a container that clips the visual overflow.  -->
        <!-- For a truly curved line, use a custom View in Java/     -->
        <!-- Kotlin — this XML approximation gives the visual feel.  -->
        <!-- ====================================================== -->
        <com.example.crosstune.CurvedSeekBar
            android:id="@+id/curvedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Time labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01:35"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-02:32"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ====================================================== -->
        <!-- Playback controls: Previous | Play/Pause | Next        -->
        <!-- ====================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Previous button -->
            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Previous"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <!-- Play / Pause button (large, white circle bg) -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_play_circle">

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play or Pause"
                    android:src="@drawable/ic_play"
                    app:tint="#000000" />
            </FrameLayout>

            <!-- Next button (mirrored back arrow) -->
            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Next"
                android:rotation="180"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
