<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="8dp">

    <!-- THE SQUARE COVER CONTAINER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cover_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#1A1C24"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2C2F3F">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- STATE 1: EMPTY PLAYLIST -->
            <ImageView
                android:id="@+id/iv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="36dp"
                android:src="@drawable/ic_playlist"
                app:tint="#5E6168" />

            <!-- STATE 2: SINGLE COVER (1-3 Songs) -->
            <ImageView
                android:id="@+id/iv_single_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- STATE 3: 2x2 COLLAGE GRID (4+ Songs) -->
            <LinearLayout
                android:id="@+id/layout_collage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0A0B0E"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <!-- The 1dp margin creates a beautiful dark separator line -->
                    <ImageView
                        android:id="@+id/iv_collage_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:scaleType="centerCrop" />
                    <ImageView
                        android:id="@+id/iv_collage_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="1dp"
                        android:layout_marginBottom="1dp"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/iv_collage_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="1dp"
                        android:layout_marginTop="1dp"
                        android:scaleType="centerCrop" />
                    <ImageView
                        android:id="@+id/iv_collage_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="1dp"
                        android:layout_marginTop="1dp"
                        android:scaleType="centerCrop" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- PLAYLIST NAME -->
    <TextView
        android:id="@+id/tv_playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@id/card_cover_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SONG COUNT -->
    <TextView
        android:id="@+id/tv_playlist_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#8A8D93"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tv_playlist_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>